#=
Fonction trouvant le chemin entre D et A sur map en suivant l'algorithme SIPP (A* modifié)
Renvoie le chemin dans un tableau de coordonnées
map | type : Dict{Tuple{Int64, Int64}, Case} | exemple : ((5, 19) => Case(1, ...))
D | type : Tuple{Int64, Int64} | exemple : (1, 1)
A | type : Tuple{Int64, Int64} | exemple : (2, 2)
time | type : Int64 | exemple : 0
Fonction astarAMR incluant la mise à jour automatique de la carte
=#
function astarAMR(map::Dict{Tuple{Int64, Int64}, Case}, D::Tuple{Int64, Int64}, A::Tuple{Int64, Int64}, time::Int64) 
    
    # 1. Initialisation de l'état (Position, ID_intervalle)
    startIntervalID = getIntervalID(map[D], time)
    startState = (D, startIntervalID)
    
    permanent = Set{Tuple{Tuple{Int64,Int64}, Int64}}()
    FilePrio = PriorityQueue()
    predecessor = Dict(startState => ((-1,-1), -1))
    times = Dict(startState => time)
    
    FilePrio[startState] = time + lenghtToA(D, A)            

    while !(isempty(FilePrio))

        current_state = dequeue!(FilePrio)
        point, current_inv_id = current_state
        t = times[current_state]

        if !(current_state in permanent)
            push!(permanent, current_state)
        
            if point == A
                # --- RECONSTRUCTION DU CHEMIN AVEC TEMPS ---
                p = current_state
                path_with_times = []
                while predecessor[p] != ((-1,-1), -1)
                    pushfirst!(path_with_times, (p[1], times[p]))          
                    p = predecessor[p]
                end
                pushfirst!(path_with_times, (D, time))

                updateInterval(map, path_with_times) # TODO ne pas bloquer D et A

                # On retourne uniquement les coordonnées pour l'affichage
                return path_with_times
            end

            # Récupération de l'intervalle de l'état actuel
            currentInterval = map[point].safeInterval[current_inv_id]

            # Exploration des successeurs SIPP
            for (neighbor_state, neighborTime) in successorSIPP(point, currentInterval, t, map)                                    
                if !(neighbor_state in permanent)
                    if neighborTime < get(times, neighbor_state, typemax(Int64))
                        times[neighbor_state] = neighborTime
                        predecessor[neighbor_state] = current_state
                        FilePrio[neighbor_state] = neighborTime + lenghtToA(neighbor_state[1], A) 
                    end
                end
            end
        end 
    end
    throw(error("Il n'y a pas de chemin entre "*string(D)*" et "*string(A)))
end

#=
Fonction retournant la distance entre les points P et A
P | type : Tuple{Int64, Int64} | exemple : (12, 14)
A | type : Tuple{Int64, Int64} | exemple : (11, 13)
=#
function lenghtToA(P::Tuple{Int64, Int64}, A::Tuple{Int64,Int64})
    return sqrt((P[2]-A[2])^2 + (P[1]-A[1])^2)
end

#=
Fonction retournant les successeurs possibles de P avec le temps d'arrivée effectif
Renvoie un tableau de tuples contenant l'état du voisin ((Point, ID_intervalle), temps_arrivée)
P | type : Tuple{Int64, Int64} | exemple : (12, 14)
currentInterval | type : SafeInterval | exemple : SafeInterval(1, 0.0, 9.2e18)
time | type : Int64 | exemple : 5
map | type: Dict{Tuple{Int64, Int64}, Case} | exemple : ((5, 19) => Case(1, ...))
=#
#=
Fonction retournant les successeurs SIPP avec protection anti-swap
=#
function successorSIPP(P::Tuple{Int64, Int64}, currentInterval::SafeInterval, time::Int64, map::Dict{Tuple{Int64, Int64}, Case})
    succ::Vector{Tuple{Tuple{Tuple{Int64,Int64}, Int64}, Int64}} = []

    for point in [(P[1]-1,P[2]), (P[1]+1,P[2]), (P[1],P[2]+1), (P[1],P[2]-1)]           
        if haskey(map, point)
            n_case = map[point]
            time_cost = n_case.weight
            
            for n_inv in n_case.safeInterval
                t_arrival = time + time_cost
                
                # 1. On vérifie si on peut arriver dans l'intervalle du voisin
                if t_arrival <= n_inv.end_t
                    actual_arrival::Int64 = max(t_arrival, n_inv.start_t)
                    wait_time = actual_arrival - t_arrival
                    
                    # 2. On vérifie si on peut attendre sur la case actuelle (P)
                    if time + wait_time <= currentInterval.end_t
                        
                        # --- PROTECTION ANTI-SWAP ---
                        # On vérifie que notre case actuelle (P) est toujours LIBRE 
                        # à l'instant précis où l'on arrive sur la case voisine.
                        # Si quelqu'un d'autre a prévu d'arriver en P à 'actual_arrival',
                        # alors faire ce mouvement causerait un swap.
                        if isInInterval(map[P], actual_arrival)
                            push!(succ, ((point, n_inv.id), actual_arrival))
                        end
                        # ----------------------------

                    end
                end
            end
        end
    end
    return succ
end

function is_contained(inv::SafeInterval, t_start::Int64, t_end::Int64)
    return inv.start_t <= t_start && t_end <= inv.end_t
end

#=
TODO
Fonction retournant vrai si il existe un interval dans lequel l'AMR peut rester à partir du temps time jusqu'à la fin de son poids
faux sinon
=#
function isInInterval(c::Case, time::Int64)
    # On cherche dans la liste des intervalles de la case
    for inv in c.safeInterval
        if is_contained(inv, time, time + c.weight -1)
            return true # On a trouvé un intervalle de sécurité qui nous contient
        end
    end
    return false # Collision inévitable sur cette case à ces temps-là
end

#=
Fonction retournant l'ID de l'intervalle de sécurité contenant le temps "time"
Renvoie l'ID sous forme d'Int64, ou -1 si non trouvé
c | type : Case | exemple : Case('.')
time | type : Int64 | exemple : 10
=#
function getIntervalID(c::Case, time::Int64)
    for inv in c.safeInterval
        if inv.start_t <= time <= inv.end_t
            return inv.id
        end
    end
    return -1
end

# --- MISE À JOUR DES INTERVALLES DE SÉCURITÉ ---
function updateInterval(map, path_with_times)
    
    # On modifie la map pour réserver le passage de cet AMR
    for i in 1:length(path_with_times)
        pos, t_in = path_with_times[i]
        
        # Pour éviter les échanges de place, on bloque la case actuelle 
        # jusqu'à ce que l'AMR soit totalement arrivé sur la case suivante.
        if i < length(path_with_times)
            t_out = path_with_times[i+1][2] 
        else
            t_out = typemax(Int64) # Destination finale bloquée
        end

        case = map[pos]
        new_intervals = Vector{SafeInterval}()
        id_count = 1

        for inv in case.safeInterval
            # Si l'intervalle est totalement en dehors de l'occupation
            if inv.end_t < t_in || inv.start_t > t_out
                push!(new_intervals, SafeInterval(id_count, inv.start_t, inv.end_t))
                id_count += 1
            else
                # Découpe en deux (avant et après l'occupation)
                if inv.start_t < t_in
                    push!(new_intervals, SafeInterval(id_count, inv.start_t, Float64(t_in - 1)))
                    id_count += 1
                end
                if inv.end_t > t_out
                    push!(new_intervals, SafeInterval(id_count, Float64(t_out + 1), inv.end_t))
                    id_count += 1
                end
            end
        end
        case.safeInterval = new_intervals
    end
end